# Place the box if the block below is solid, otherwise fall one block and try again.
# The placing line comes first: after the fall returns, a box sits below every
# level above it, and a check at that point would stack a box on each one.
# Below the world both checks fail, so nothing is placed and the fall ends.
execute unless block ~ ~-1 ~ #minecraft:replaceable run setblock ~ ~ ~ minecraft:cyan_shulker_box{Items:[{Slot:0b,id:"minecraft:beacon",count:5},{Slot:1b,id:"minecraft:netherite_block",count:64},{Slot:2b,id:"minecraft:netherite_block",count:64},{Slot:3b,id:"minecraft:netherite_block",count:64},{Slot:4b,id:"minecraft:conduit",count:8},{Slot:5b,id:"minecraft:anvil",count:16},{Slot:6b,id:"minecraft:grindstone",count:4},{Slot:7b,id:"minecraft:smithing_table",count:4},{Slot:8b,id:"minecraft:enchanting_table",count:4},{Slot:9b,id:"minecraft:bookshelf",count:64},{Slot:10b,id:"minecraft:brewing_stand",count:8},{Slot:11b,id:"minecraft:cauldron",count:8},{Slot:12b,id:"minecraft:blaze_powder",count:64},{Slot:13b,id:"minecraft:nether_wart",count:64},{Slot:14b,id:"minecraft:glowstone_dust",count:64},{Slot:15b,id:"minecraft:redstone",count:64},{Slot:16b,id:"minecraft:gunpowder",count:64},{Slot:17b,id:"minecraft:dragon_breath",count:64},{Slot:18b,id:"minecraft:glass_bottle",count:64},{Slot:19b,id:"minecraft:experience_bottle",count:64},{Slot:20b,id:"minecraft:experience_bottle",count:64},{Slot:21b,id:"minecraft:lapis_lazuli",count:64},{Slot:22b,id:"minecraft:shulker_shell",count:64},{Slot:23b,id:"minecraft:ender_eye",count:64},{Slot:24b,id:"minecraft:name_tag",count:64},{Slot:25b,id:"minecraft:crafting_table",count:16},{Slot:26b,id:"minecraft:furnace",count:16}]} replace
