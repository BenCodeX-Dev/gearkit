# Place the box if the block below is solid, otherwise fall one block and try again.
# The placing line comes first: after the fall returns, a box sits below every
# level above it, and a check at that point would stack a box on each one.
# Below the world both checks fail, so nothing is placed and the fall ends.
execute unless block ~ ~-1 ~ #minecraft:replaceable run setblock ~ ~ ~ minecraft:brown_shulker_box{Items:[{Slot:0b,id:"minecraft:enchanted_golden_apple",count:64},{Slot:1b,id:"minecraft:enchanted_golden_apple",count:64},{Slot:2b,id:"minecraft:golden_apple",count:64},{Slot:3b,id:"minecraft:golden_carrot",count:64},{Slot:4b,id:"minecraft:cooked_beef",count:64},{Slot:5b,id:"minecraft:cooked_porkchop",count:64},{Slot:6b,id:"minecraft:bread",count:64},{Slot:7b,id:"minecraft:milk_bucket",count:1},{Slot:8b,id:"minecraft:cake",count:1},{Slot:9b,id:"minecraft:honey_bottle",count:16},{Slot:10b,id:"minecraft:dried_kelp_block",count:64},{Slot:11b,id:"minecraft:obsidian",count:64},{Slot:12b,id:"minecraft:netherite_block",count:64},{Slot:13b,id:"minecraft:iron_block",count:64},{Slot:14b,id:"minecraft:gold_block",count:64},{Slot:15b,id:"minecraft:diamond_block",count:64},{Slot:16b,id:"minecraft:emerald_block",count:64},{Slot:17b,id:"minecraft:cobblestone",count:64},{Slot:18b,id:"minecraft:dirt",count:64},{Slot:19b,id:"minecraft:sand",count:64},{Slot:20b,id:"minecraft:gravel",count:64},{Slot:21b,id:"minecraft:oak_planks",count:64},{Slot:22b,id:"minecraft:torch",count:64},{Slot:23b,id:"minecraft:tnt",count:64},{Slot:24b,id:"minecraft:flint_and_steel",count:1},{Slot:25b,id:"minecraft:bucket",count:16},{Slot:26b,id:"minecraft:string",count:64}]} replace
