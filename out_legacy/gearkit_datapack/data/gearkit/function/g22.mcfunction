# Place the box if the block below is solid, otherwise fall one block and try again.
# The placing line comes first: after the fall returns, a box sits below every
# level above it, and a check at that point would stack a box on each one.
# Below the world both checks fail, so nothing is placed and the fall ends.
execute unless block ~ ~-1 ~ #minecraft:replaceable run setblock ~ ~ ~ minecraft:gray_shulker_box{Items:[{Slot:0b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:regeneration"}}},{Slot:1b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:long_regeneration"}}},{Slot:2b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:strong_regeneration"}}},{Slot:3b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:strength"}}},{Slot:4b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:long_strength"}}},{Slot:5b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:strong_strength"}}},{Slot:6b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:weakness"}}},{Slot:7b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:long_weakness"}}},{Slot:8b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:luck"}}},{Slot:9b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:slow_falling"}}},{Slot:10b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:long_slow_falling"}}},{Slot:11b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:wind_charged"}}},{Slot:12b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:weaving"}}},{Slot:13b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:oozing"}}},{Slot:14b,id:"minecraft:tipped_arrow",count:64,components:{"minecraft:potion_contents":{potion:"minecraft:infested"}}}]} replace
